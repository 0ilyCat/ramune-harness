{
  "name": "ramune-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/dev.ts",
    "build": "tsc --noEmit && vite build && tsup server/index.ts --format esm --platform node --target node24 --out-dir dist/server --external vite",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "node scripts/live-smoke.mjs",
    "test:restart": "node scripts/restart-smoke.mjs",
    "deploy:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-windows.ps1",
    "deploy:wsl": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-wsl.ps1"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@xyflow/react": "^12.12.0",
    "execa": "^10.2.1",
    "hono": "^4.13.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
